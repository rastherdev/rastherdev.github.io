---
import Badge from "./Badge.astro";
import type { Project } from "../../data/projects";
import type { ProjectsDict } from "../../i18n/types";

export interface Props {
  project: Project;
  dict: ProjectsDict;
  index: number;
}
---

<dialog
  class="modal-overlay"
  data-project-index={Astro.props.index}
  aria-labelledby={`project-dialog-title-${Astro.props.project.id}`}
  aria-describedby={`project-dialog-description-${Astro.props.project.id}`}
>
  <div class="modal">
    <button class="modal__close" aria-label={Astro.props.dict.close} type="button">
      <span class="modal__close-icon" aria-hidden="true">✕</span>
    </button>

    <div class="modal__body">
      <header class="modal__header">
        <h2 class="modal__name" id={`project-dialog-title-${Astro.props.project.id}`}>
          {Astro.props.project.name}
        </h2>
        <p class="modal__desc" id={`project-dialog-description-${Astro.props.project.id}`}>
          {Astro.props.project.description}
        </p>
      </header>

      <div class="modal__stack">
        <span class="modal__stack-label">{Astro.props.dict.techStack}:</span>
        {Astro.props.project.stack.map((t: string) => <Badge text={t} />)}
      </div>

      <div class="modal__grid">
        <div class="modal__section">
          <h3 class="modal__section-title">{Astro.props.dict.context}</h3>
          <p class="modal__section-text">{Astro.props.project.context}</p>
        </div>
        <div class="modal__section">
          <h3 class="modal__section-title">{Astro.props.dict.contribution}</h3>
          <p class="modal__section-text">{Astro.props.project.contribution}</p>
        </div>
      </div>

      <div class="modal__actions">
        <a href={Astro.props.project.url} target="_blank" rel="noopener noreferrer" class="modal__link modal__link--primary">
          {Astro.props.dict.viewProject} ↗
        </a>
      </div>
    </div>
  </div>
</dialog>

<style>
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: var(--space-xl);
    border: 0;
    color: var(--color-text);
    background: transparent;
    display: none;
    align-items: center;
    justify-content: center;
  }

  .modal-overlay[open] {
    display: flex;
  }

  .modal-overlay::backdrop {
    background: rgba(4, 4, 10, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .modal {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-xl);
    max-width: 720px;
    width: 100%;
    max-height: 85vh;
    max-height: 85dvh;
    overflow-y: auto;
    position: relative;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
  }

  .modal__close {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-text-muted);
    font-size: var(--text-base);
    transition: all var(--transition-fast);
    z-index: 1;
  }

  .modal__close:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .modal__body {
    padding: var(--space-2xl);
  }

  .modal__header {
    margin-bottom: var(--space-xl);
    padding-right: var(--space-3xl);
  }

  .modal__name {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-sm);
  }

  .modal__desc {
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .modal__stack {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .modal__stack-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-right: var(--space-xs);
  }

  .modal__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .modal__section-title {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-sm);
  }

  .modal__section-text {
    color: var(--color-text-muted);
    line-height: 1.7;
    font-size: var(--text-sm);
  }

  .modal__actions {
    display: flex;
    gap: var(--space-md);
  }

  .modal__link {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    padding: 0.65rem 1.2rem;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    color: var(--color-text);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .modal__link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .modal__link--primary {
    background: var(--color-accent);
    color: var(--color-bg);
    border-color: var(--color-accent);
  }

  .modal__link--primary:hover {
    background: transparent;
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .modal__grid {
      grid-template-columns: 1fr;
    }

    .modal__body {
      padding: var(--space-lg);
    }

    .modal__actions {
      flex-direction: column;
    }
  }
</style>
