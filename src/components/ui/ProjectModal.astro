---
import Badge from "./Badge.astro";
import SystemFlows from "./SystemFlows.astro";
import type { Project } from "../../data/projects";
import type { ProjectTranslation, ProjectsDict } from "../../i18n/types";

type ProjectDetails = Project &
  ProjectTranslation & {
    role: string;
    company: string;
    period: string;
  };

export interface Props {
  project: ProjectDetails;
  dict: ProjectsDict;
  index: number;
}
---

<dialog
  class="modal-overlay"
  data-project-index={Astro.props.index}
  aria-labelledby={`project-dialog-title-${Astro.props.project.id}`}
  aria-describedby={`project-dialog-description-${Astro.props.project.id}`}
>
  <div class="modal">
    <button class="modal__close" aria-label={Astro.props.dict.close} type="button">
      <span class="modal__close-icon" aria-hidden="true">✕</span>
    </button>

    <div class="modal__body">
      <header class="modal__header">
        <h2 class="modal__name" id={`project-dialog-title-${Astro.props.project.id}`}>
          {Astro.props.project.name}
        </h2>
        <p class="modal__desc" id={`project-dialog-description-${Astro.props.project.id}`}>
          {Astro.props.project.description}
        </p>
      </header>

      <dl class="modal__meta">
        <div class="modal__meta-item">
          <dt>{Astro.props.dict.roleLabel}</dt>
          <dd>{Astro.props.project.role}</dd>
        </div>
        <div class="modal__meta-item">
          <dt>{Astro.props.dict.organizationLabel}</dt>
          <dd>{Astro.props.project.company}</dd>
        </div>
        <div class="modal__meta-item">
          <dt>{Astro.props.dict.periodLabel}</dt>
          <dd>{Astro.props.project.period}</dd>
        </div>
      </dl>

      <div class="modal__stack">
        <span class="modal__stack-label">{Astro.props.dict.techStack}:</span>
        {Astro.props.project.stack.map((t: string) => <Badge text={t} />)}
      </div>

      <section
        class="modal__gallery"
        aria-labelledby={`project-gallery-${Astro.props.project.id}`}
      >
        <h3
          class="modal__section-title"
          id={`project-gallery-${Astro.props.project.id}`}
        >
          {Astro.props.dict.galleryLabel}
        </h3>
        {Astro.props.project.gallery.length > 0 ? (
          <div class="modal__gallery-grid">
            {Astro.props.project.gallery.map((image) => (
              <figure class="modal__gallery-item">
                <img
                  src={image.src}
                  alt={image.alt}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            ))}
          </div>
        ) : (
          <div class="modal__gallery-empty" role="status">
            <span class="modal__gallery-mark" aria-hidden="true">
              <svg
                width="34"
                height="34"
                viewBox="0 0 48 48"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="6.75" y="8.75" width="34.5" height="30.5" rx="4.25" />
                <circle cx="18" cy="19" r="3" />
                <path d="m10 34 9-9 6 6 5-5 8 8" />
              </svg>
            </span>
            <div class="modal__gallery-copy">
              <h4>{Astro.props.dict.galleryEmptyTitle}</h4>
              <p>{Astro.props.dict.galleryEmptyDescription}</p>
            </div>
          </div>
        )}
      </section>

      <div class="modal__details">
        <section
          class="modal__architecture"
          aria-labelledby={`project-architecture-${Astro.props.project.id}`}
        >
          <h3
            class="modal__section-title"
            id={`project-architecture-${Astro.props.project.id}`}
          >
            {Astro.props.dict.architectureLabel}
          </h3>
          <SystemFlows flows={Astro.props.project.caseStudy.flows} />
        </section>

        <section
          class="modal__contributions"
          aria-labelledby={`project-contributions-${Astro.props.project.id}`}
        >
          <h3
            class="modal__section-title"
            id={`project-contributions-${Astro.props.project.id}`}
          >
            {Astro.props.dict.contributionsLabel}
          </h3>
          <ul class="modal__contribution-list">
            {Astro.props.project.caseStudy.contributions.map((item) => (
              <li class="modal__contribution-item">
                <span class="modal__work-marker" aria-hidden="true"></span>
                <div>
                  <h4 class="modal__contribution-title">{item.title}</h4>
                  <p class="modal__contribution-text">{item.detail}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>
      </div>

    </div>
    <div class="modal__actions">
      <a href={Astro.props.project.url} target="_blank" rel="noopener noreferrer" class="modal__link modal__link--primary">
        {Astro.props.dict.visitSite} ↗
      </a>
    </div>
  </div>
</dialog>

<style>
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: var(--space-lg);
    border: 0;
    color: var(--color-text);
    background: transparent;
    display: none;
    align-items: center;
    justify-content: center;
  }

  .modal-overlay[open] {
    display: flex;
  }

  .modal-overlay::backdrop {
    background: rgba(4, 4, 10, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .modal {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-xl);
    max-width: 1000px;
    width: 100%;
    max-height: 90vh;
    max-height: 90dvh;
    overflow: hidden;
    position: relative;
    display: flex;
    flex-direction: column;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
  }

  .modal__close {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-text-muted);
    font-size: var(--text-base);
    transition: all var(--transition-fast);
    z-index: 1;
  }

  .modal__close:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .modal__body {
    flex: 1 1 auto;
    min-height: 0;
    padding: var(--space-2xl);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .modal__header {
    margin-bottom: var(--space-lg);
    padding-right: var(--space-3xl);
  }

  .modal__name {
    font-size: var(--text-3xl);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-sm);
  }

  .modal__desc {
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .modal__meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0 0 var(--space-lg);
    border-block: 1px solid var(--color-border);
  }

  .modal__meta-item {
    min-width: 0;
    padding: var(--space-md) var(--space-lg);
  }

  .modal__meta-item:first-child {
    padding-left: 0;
  }

  .modal__meta-item + .modal__meta-item {
    border-left: 1px solid var(--color-border);
  }

  .modal__meta-item dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .modal__meta-item dd {
    margin: var(--space-xs) 0 0;
    color: var(--color-text);
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  .modal__stack {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .modal__stack-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-right: var(--space-xs);
  }

  .modal__gallery {
    margin-bottom: var(--space-xl);
  }

  .modal__gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-md);
  }

  .modal__gallery-item {
    margin: 0;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-lg);
  }

  .modal__gallery-item img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .modal__gallery-empty {
    min-height: 116px;
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    padding: var(--space-lg);
    background:
      linear-gradient(110deg, rgba(77, 212, 192, 0.045), transparent 70%),
      var(--color-surface-raised);
    border: 1px dashed var(--color-border-hover);
    border-radius: var(--border-radius-lg);
  }

  .modal__gallery-mark {
    width: 56px;
    height: 56px;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    color: var(--color-code);
    background: rgba(77, 212, 192, 0.05);
    border: 1px solid rgba(77, 212, 192, 0.2);
    border-radius: var(--border-radius);
  }

  .modal__gallery-copy {
    max-width: 46ch;
  }

  .modal__gallery-copy h4 {
    margin-bottom: var(--space-xs);
    color: var(--color-text);
    font-size: var(--text-base);
  }

  .modal__gallery-copy p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .modal__details {
    display: grid;
    grid-template-columns: 1fr;
    align-items: start;
    gap: var(--space-xl);
  }

  .modal__section-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--color-text);
    margin: 0 0 var(--space-lg);
  }

  .modal__architecture {
    min-width: 0;
    padding: var(--space-lg);
    background:
      radial-gradient(ellipse at top left, rgba(77, 212, 192, 0.06), transparent 60%),
      var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-lg);
  }

  .modal__contribution-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .modal__contribution-item {
    display: grid;
    grid-template-columns: 8px minmax(0, 1fr);
    gap: var(--space-sm);
    padding: var(--space-md) 0;
    border-top: 1px solid var(--color-border);
  }

  .modal__contribution-item:first-child,
  .modal__contribution-item:nth-child(2) {
    border-top: 0;
    padding-top: 0;
  }

  .modal__work-marker {
    width: 6px;
    height: 6px;
    margin-top: 0.55em;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .modal__contribution-title {
    margin-bottom: var(--space-xs);
    color: var(--color-text);
    font-size: var(--text-base);
  }

  .modal__contribution-text {
    color: var(--color-text-muted);
    line-height: 1.7;
    font-size: var(--text-sm);
  }

  .modal__link {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    padding: 0.65rem 1.2rem;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    color: var(--color-text);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .modal__link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .modal__link--primary {
    background: var(--color-accent);
    color: var(--color-bg);
    border-color: var(--color-accent);
  }

  .modal__link--primary:hover {
    background: transparent;
    color: var(--color-accent);
  }

  .modal__actions {
    flex: 0 0 auto;
    display: flex;
    gap: var(--space-md);
    padding: var(--space-md) var(--space-2xl);
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  @media (max-width: 768px) {
    .modal-overlay {
      padding: var(--space-sm);
    }

    .modal {
      max-height: 94vh;
      max-height: 94dvh;
    }

    .modal__body {
      padding: var(--space-lg);
    }

    .modal__meta {
      grid-template-columns: 1fr;
    }

    .modal__meta-item {
      padding: var(--space-sm) 0;
    }

    .modal__meta-item + .modal__meta-item {
      border-top: 1px solid var(--color-border);
      border-left: 0;
    }

    .modal__contribution-list {
      grid-template-columns: 1fr;
    }

    .modal__contribution-item:nth-child(2) {
      border-top: 1px solid var(--color-border);
      padding-top: var(--space-md);
    }

    .modal__gallery-empty {
      align-items: flex-start;
      gap: var(--space-md);
      padding: var(--space-md);
    }

    .modal__gallery-mark {
      width: 44px;
      height: 44px;
    }

    .modal__link {
      width: 100%;
    }

    .modal__actions {
      padding: var(--space-md) var(--space-lg);
    }
  }
</style>
