---
export interface Props {
  transcript: import("../../i18n/types").TerminalTranscript;
}

const { transcript } = Astro.props;

if (transcript.output.length === 0) {
  throw new Error("The hero terminal requires at least one profile field.");
}
---

<div class="terminal" aria-hidden="true" id="hero-terminal-el">
  <div class="terminal__header">
    <span class="terminal__dot terminal__dot--red"></span>
    <span class="terminal__dot terminal__dot--yellow"></span>
    <span class="terminal__dot terminal__dot--green"></span>
    <span class="terminal__title">guest@portfolio — bash</span>
  </div>
  <div class="terminal__body">
    <div class="terminal__line">
      <span class="terminal__prompt">$&nbsp;</span>
      <span class="terminal__command">{transcript.command}</span>
    </div>
    <div class="terminal__output">
      {transcript.output.map(({ label, value }) => (
        <div class="terminal__output-row">
          <span class="terminal__key">{label}</span>
          <span class="terminal__value">{value}</span>
        </div>
      ))}
    </div>
    <div class="terminal__line">
      <span class="terminal__prompt">$&nbsp;</span>
      <span class="terminal__cursor" aria-hidden="true">▌</span>
    </div>
  </div>
</div>

<style>
  .terminal {
    background: rgba(0, 0, 0, 0.55);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    box-shadow: var(--shadow-lg), 0 0 40px rgba(240, 160, 48, 0.05);
    width: 100%;
    max-width: 540px;
    /* no backdrop-filter: over this near-uniform dark bg the blur was
       invisible, but re-filtered every frame while the hero parallax moved */
  }

  .terminal__header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0.6rem 1rem;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid var(--color-border);
  }

  .terminal__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .terminal__dot--red { background: #ff5f57; }
  .terminal__dot--yellow { background: #febc2e; }
  .terminal__dot--green { background: #28c840; }

  .terminal__title {
    margin-left: var(--space-sm);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .terminal__body {
    padding: 1rem 1.2rem;
    min-height: 200px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .terminal__line {
    display: flex;
    gap: 0;
    color: var(--color-code);
    line-height: 1.7;
    min-height: 1.7em;
  }

  .terminal__prompt {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .terminal__command {
    color: var(--color-text);
  }

  .terminal__cursor {
    color: var(--color-accent);
    animation: blink 1s step-end infinite;
  }

  .terminal__output {
    display: grid;
    gap: 0.2rem;
    padding-left: 1.2em;
  }

  .terminal__output-row {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: var(--space-sm);
    line-height: 1.55;
  }

  .terminal__key {
    color: var(--color-text-muted);
  }

  .terminal__key::after {
    content: ":";
  }

  .terminal__value {
    color: var(--color-code);
    overflow-wrap: anywhere;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal__cursor {
      animation: none;
    }
  }
</style>
