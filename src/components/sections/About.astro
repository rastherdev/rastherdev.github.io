---
import SectionHeading from "../ui/SectionHeading.astro";
import SystemFlows from "../ui/SystemFlows.astro";
import en from "../../i18n/en";
import es from "../../i18n/es";

interface Props {
  locale: "en" | "es";
}

// Tech terms auto-highlighted in the bio (same spelling in EN and ES)
const KEYWORDS = ["Laravel", "PostgreSQL", "Redis", "REST APIs", "APIs REST", "CodeIgniter 4", "MySQL"];
const kwRegex = new RegExp(`(${KEYWORDS.join("|")})`, "gi");
const isKeyword = (part: string) =>
  KEYWORDS.some((k) => k.toLowerCase() === part.toLowerCase());
---

{(() => {
  const dict = Astro.props.locale === "en" ? en : es;
  const systemFlows = dict.projects.translations.bloomingtec.caseStudy.flows;

  return (
    <section class="about section section--band" id="about">
      <div class="section__inner">
        <div class="about__panel" id="about-panel">
          <SectionHeading title={dict.about.heading} />
          <div class="about__grid">
            <aside class="about__system" aria-labelledby="about-system-title">
              <div class="about__system-bar" aria-hidden="true">
                <span class="about__facts-dot about__facts-dot--red"></span>
                <span class="about__facts-dot about__facts-dot--yellow"></span>
                <span class="about__facts-dot about__facts-dot--green"></span>
                <span class="about__facts-title">giovany@portfolio: ~/systems</span>
              </div>
              <div class="about__system-body">
                <h3 class="about__system-heading" id="about-system-title">
                  {dict.projects.architectureLabel}
                </h3>
                <SystemFlows flows={systemFlows} />
              </div>
            </aside>

            <div class="about__bio">
              {dict.about.bio.map((p) => (
                <p class="about__paragraph">
                  {p.split(kwRegex).map((part) =>
                    isKeyword(part) ? <mark class="about__hl">{part}</mark> : part
                  )}
                </p>
              ))}
            </div>
          </div>

          <dl class="about__facts">
            {dict.about.quickFacts.map((fact) => (
              <div class="about__fact">
                <dt class="about__fact-label">
                  <span class="about__fact-prompt" aria-hidden="true">$</span> {fact.label}
                </dt>
                <dd class="about__fact-value">{fact.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>
  );
})()}

<style>
  .about {
    position: relative;
    overflow: hidden;
  }

  /* ── Panel: light wash + animated beam border to delimit the section ── */
  .about__panel {
    position: relative;
    z-index: 2;
    border-radius: var(--border-radius-xl);
    border: 1px solid var(--color-border);
    padding: clamp(var(--space-xl), 4vw, var(--space-3xl));
    background: linear-gradient(
      180deg,
      rgba(226, 226, 240, 0.05),
      rgba(226, 226, 240, 0.015) 45%,
      rgba(17, 17, 34, 0.4)
    );
    box-shadow: 0 0 60px rgba(226, 226, 240, 0.03) inset, var(--shadow-lg);
  }

  /* Soft light spill above the panel edge */
  .about__panel::after {
    content: "";
    position: absolute;
    top: 0;
    left: 10%;
    right: 10%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(226, 226, 240, 0.35), transparent);
    filter: blur(0.5px);
    pointer-events: none;
  }

  /* ── Layout ──────────────────────────────────────────── */
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: var(--space-3xl);
    align-items: start;
    position: relative;
    z-index: 2;
  }

  .about__bio {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .about__paragraph {
    color: var(--color-text-muted);
    line-height: 1.8;
    font-size: var(--text-base);
    transition: color 0.3s ease;
  }

  .about__paragraph:first-of-type {
    font-size: var(--text-lg);
    color: var(--color-text);
    line-height: 1.6;
    font-weight: 500;
  }

  /* Auto-highlighted tech keywords */
  .about__hl {
    background: none;
    color: var(--color-accent);
    font-weight: 500;
    border-bottom: 1px dotted rgba(240, 160, 48, 0.45);
  }

  .about__system {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .about__system::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(ellipse at 30% 20%, rgba(77, 212, 192, 0.04), transparent 60%);
    pointer-events: none;
  }

  .about__system-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.6rem 1rem;
    background: rgba(0, 0, 0, 0.35);
    border-bottom: 1px solid var(--color-border);
  }

  .about__facts-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  .about__facts-dot--red { background: #ff5f57; }
  .about__facts-dot--yellow { background: #febc2e; }
  .about__facts-dot--green { background: #28c840; }

  .about__facts-title {
    margin-left: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .about__system-body {
    position: relative;
    padding: var(--space-lg);
  }

  .about__system-heading {
    margin-bottom: var(--space-lg);
    color: var(--color-accent);
    font-size: var(--text-lg);
  }

  .about__facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: var(--space-2xl) 0 0;
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .about__fact {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    padding-inline: var(--space-lg);
    transition: translate 0.3s ease;
  }

  .about__fact:first-child {
    padding-left: 0;
  }

  .about__fact + .about__fact {
    border-left: 1px solid var(--color-border);
  }

  .about__fact-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-transform: lowercase;
  }

  .about__fact-prompt {
    color: var(--color-code);
  }

  .about__fact-value {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text);
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  @media (max-width: 960px) {
    .about__grid {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }
  }

  @media (max-width: 768px) {
    .about__panel {
      padding: var(--space-lg);
    }

    .about :global(.section-heading) {
      margin-bottom: var(--space-2xl);
    }

    .about :global(.section-heading__title) {
      font-size: clamp(1.7rem, 8vw, 2rem);
      line-height: 1.15;
      text-wrap: balance;
    }

    .about__paragraph:first-of-type {
      font-size: clamp(1rem, 4.5vw, 1.1rem);
    }

    .about__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-lg) var(--space-md);
    }

    .about__fact {
      padding-inline: var(--space-md);
    }

    .about__fact:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }

    .about__fact:nth-child(even) {
      border-left: 1px solid var(--color-border);
    }
  }
</style>

<script>
  import { gsap } from "../../scripts/utils/gsap-setup";

  const mm = gsap.matchMedia();

  mm.add("(prefers-reduced-motion: no-preference)", () => {
    // Section entrance
    const tl = gsap.timeline({
      scrollTrigger: { trigger: ".about", start: "top 65%", once: true },
    });

    // Panel reveals first, then its content
    tl.from("#about-panel", {
      opacity: 0,
      y: 40,
      scale: 0.985,
      duration: 0.8,
      ease: "power3.out",
    })
      // Heading scale-in
      .from(".about .section-heading__title", {
        opacity: 0, y: 30, scale: 0.95, duration: 0.7, ease: "power3.out",
      }, "-=0.4")
      .from(".about .section-heading__line", {
        scaleX: 0, opacity: 0, duration: 0.5, ease: "power3.out",
      }, "-=0.3")
      // Architecture leads; the supporting bio follows
      .from(".about__system", {
        opacity: 0, x: -40, duration: 0.6, ease: "power3.out",
        clearProps: "transform",
      }, "-=0.1")
      .from(".about__paragraph", {
        opacity: 0, x: 40, stagger: 0.12, duration: 0.55, ease: "power3.out",
      }, "-=0.25")
      // Profile facts settle in last
      .from(".about__fact", {
        opacity: 0, y: 12, stagger: 0.08, duration: 0.4, ease: "power3.out",
        clearProps: "transform",
      }, "-=0.2");
  });
</script>
