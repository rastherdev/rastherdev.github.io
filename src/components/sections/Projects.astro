---
import SectionHeading from "../ui/SectionHeading.astro";
import Card from "../ui/Card.astro";
import ProjectModal from "../ui/ProjectModal.astro";
import en from "../../i18n/en";
import es from "../../i18n/es";
import { projects } from "../../data/projects";
import { experience, formatMonthYear } from "../../data/experience";

interface Props {
  locale: "en" | "es";
}
---

{(() => {
  const dict = Astro.props.locale === "en" ? en : es;
  const dateLocale = Astro.props.locale === "es" ? "es-MX" : "en-US";
  const localizedProjects = projects.map((project) => {
    const relatedExperience = experience.find((entry) => entry.id === project.experienceId);
    if (!relatedExperience) {
      throw new Error(`Missing experience data for project "${project.id}".`);
    }

    const experienceTranslation = dict.experience.translations[relatedExperience.id];
    const period = `${formatMonthYear(relatedExperience.startDate, dateLocale)} — ${
      relatedExperience.endDate
        ? formatMonthYear(relatedExperience.endDate, dateLocale)
        : dict.experience.present
    }`;

    return {
      ...project,
      ...dict.projects.translations[project.id],
      role: experienceTranslation?.role ?? relatedExperience.role,
      company: experienceTranslation?.company ?? relatedExperience.company,
      period,
    };
  });

  return (
    <section class="projects section" id="projects">
      <div class="section__inner">
        <SectionHeading title={dict.projects.heading} />

        <div class="projects__grid">
          {localizedProjects.map((project, i) => (
            <Card project={project} dict={dict.projects} index={i} />
          ))}
        </div>
      </div>

      <!-- Dialogs move to body so native modal stacking and focus stay predictable. -->
      <div id="project-modals" hidden>
        {localizedProjects.map((project, i) => (
          <ProjectModal project={project} dict={dict.projects} index={i} />
        ))}
      </div>
    </section>
  );
})()}

<style>
  .projects__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
    gap: var(--space-xl);
  }

  @media (max-width: 768px) {
    .projects__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { gsap } from "../../scripts/utils/gsap-setup";

  const mm = gsap.matchMedia();

  mm.add("(prefers-reduced-motion: no-preference)", () => {
    const tl = gsap.timeline({
      scrollTrigger: { trigger: ".projects", start: "top 70%", once: true },
    });

    tl.from(".projects .section-heading__title", {
      opacity: 0, y: 20, duration: 0.6, ease: "power3.out",
    })
      .from(".projects .section-heading__line", {
        scaleX: 0, opacity: 0, duration: 0.5, ease: "power3.out",
      }, "-=0.2")
      .from(".project-card", {
        opacity: 0, y: 50, scale: 0.96, stagger: 0.15, duration: 0.7, ease: "power3.out",
        clearProps: "transform", // hand transform back to the CSS hover (Card.astro)
      }, "-=0.1");
  });

  const modalsContainer = document.getElementById("project-modals");
  if (!modalsContainer) {
    throw new Error("The project dialog container is missing.");
  }

  const modals = Array.from(
    modalsContainer.querySelectorAll<HTMLDialogElement>(".modal-overlay[data-project-index]")
  );
  modals.forEach((modal) => document.body.appendChild(modal));
  modalsContainer.remove();

  document.querySelectorAll<HTMLButtonElement>(".project-card__detail-hint").forEach((button) => {
    button.addEventListener("click", () => {
      const modal = modals[Number(button.dataset.projectIndex)];
      if (!modal || modal.open) return;

      modal.showModal();
      if (window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
        gsap.fromTo(
          modal.querySelectorAll(".modal__body > *"),
          { opacity: 0, y: 18 },
          { opacity: 1, y: 0, stagger: 0.07, duration: 0.45, ease: "power2.out", delay: 0.1 }
        );
      }
    });
  });

  modals.forEach((modal) => {
    modal.querySelector<HTMLButtonElement>(".modal__close")?.addEventListener("click", () => {
      modal.close();
    });
    modal.addEventListener("click", (event) => {
      if (event.target === modal) modal.close();
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    const openModal = modals.find((modal) => modal.open);
    if (!openModal) return;
    event.preventDefault();
    openModal.close();
  });
</script>
